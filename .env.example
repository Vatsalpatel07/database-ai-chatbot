# Application
APP_NAME=Database AI Chatbot

# Canonical Active Database: PostgreSQL 18.x + pgvector
DB_ENGINE=postgresql
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=mnghealthreportingdb
DB_SCHEMA=dbo
DB_USER=postgres
DB_PASSWORD=
DB_TIMEOUT=30
DB_QUERY_TIMEOUT=30

# Optional Rollback Database: Microsoft SQL Server
# DB_ENGINE=sqlserver
# DB_SERVER=localhost
# DB_NAME=mnghealthreportingdb
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_TRUST_SERVER_CERTIFICATE=true
# DB_TRUSTED_CONNECTION=yes
# DB_ENCRYPT=mandatory
# DB_TIMEOUT=30

# DeepSeek LLM
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Orchestration & Logging
MAX_SELECTED_TABLES=5
LOG_LEVEL=INFO
